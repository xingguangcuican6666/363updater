{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Download Modrinth modpack configuration updates with three-way merging",
  "authors": ["${mod_author}"],
  "contact": {
    "homepage": "https://github.com/fanziyun/363updater",
    "sources": "https://github.com/fanziyun/363updater"
  },
  "license": "${mod_license}",
  "icon": "assets/updater363/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.github.fanziyun.updater.fabric.FabricUpdater"],
    "modmenu": ["com.github.fanziyun.updater.fabric.ModMenuIntegration"]
  },
  "mixins": [
    {
      "config": "updater363.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version_min}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "minecraft": "${minecraft_version}",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*",
    "changelog363": "*"
  }
}
